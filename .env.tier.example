# Service Tier Configuration
# Copy to .env.tier and customize

# Default tier when running ./scripts/start-services.sh with no arguments
# Options: minimal, standard, production, full
DEFAULT_TIER=standard

# For custom tier, specify which tiers to enable (comma-separated)
# Available: essential,monitoring,advanced-monitoring,observability,security,performance
# CUSTOM_TIERS=essential,monitoring,security
